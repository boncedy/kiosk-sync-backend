# Server
PORT=3001
NODE_ENV=development

# Database — matches the docker-compose.yml service below
DATABASE_URL="postgresql://kiosk_user:password123@localhost:5432/kiosk_db?schema=public"

# CORS — comma-separated list of allowed browser origins
CLIENT_ORIGIN="http://localhost:3000"

# HMAC key used to sign tamper-evident receipts.
# REQUIRED outside local development: use a long random value.
RECEIPT_SIGNING_KEY="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Google Sheets mirror (optional — leave blank to disable entirely)
#
# 1. Create a service account in Google Cloud and enable the Google Sheets API.
# 2. Download its JSON key.
# 3. Share the target spreadsheet with the service account's client_email
#    as an Editor.
# Spreadsheet ID = the part between /d/ and /edit/ in the sheet URL.
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_SHEET_NAME="DailyLogs"
GOOGLE_SHEETS_TIMEZONE="Asia/Bangkok"
GOOGLE_SHEETS_TIMEOUT_MS=15000

# Supply credentials with exactly ONE of the following three options.
# (a) The whole JSON key on one line, or base64 of the file
GOOGLE_SERVICE_ACCOUNT_JSON=""
# (b) The two fields from the JSON key (keep the \n escapes in the private key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
# (c) A path to the JSON key file — keep that file out of git
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=""

# ---------------------------------------------------------------------------
# Evidence photo hosting via imgBB (optional)
# Create a key at https://api.imgbb.com/. Photos are uploaded to imgBB and only
# the returned CDN URL is stored on DailyLog.proofImageUrl. Leave empty and the
# evidence route answers 503, which tells the kiosk to keep the entry queued.
# ---------------------------------------------------------------------------
IMGBB_API_KEY=""
# How long to wait for an imgBB upload before answering 503 (milliseconds).
# Multi-megabyte phone photos need a generous budget.
IMGBB_TIMEOUT_MS=90000
